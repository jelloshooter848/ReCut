{
  "name": "recut",
  "productName": "ReCut",
  "version": "0.8.2",
  "description": "A Premiere-style desktop video editor purpose-built for fan edits of movies and television",
  "main": "dist/electron/main.js",
  "private": true,
  "license": "MIT",
  "author": "ReCut contributors",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "setup": "node scripts/setup-dev.mjs",
    "start": "node scripts/setup-dev.mjs && npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test -c tests/e2e/playwright.config.ts",
    "perf:check": "node tests/perf/perf-check.mjs",
    "perf:compare": "node tests/perf/perf-compare.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "7.0.0",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "app.recut.editor",
    "productName": "ReCut",
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/tesseract.js{,/**}",
      "!node_modules/tesseract.js-core{,/**}",
      "!node_modules/bmp-js{,/**}",
      "!node_modules/idb-keyval{,/**}",
      "!node_modules/is-url{,/**}",
      "!node_modules/node-fetch{,/**}",
      "!node_modules/opencollective-postinstall{,/**}",
      "!node_modules/regenerator-runtime{,/**}",
      "!node_modules/tr46{,/**}",
      "!node_modules/wasm-feature-detect{,/**}",
      "!node_modules/webidl-conversions{,/**}",
      "!node_modules/whatwg-url{,/**}",
      "!node_modules/zlibjs{,/**}"
    ],
    "asarUnpack": [
      "dist/electron/ocr/**"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/whisper",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo;Video;AudioVideoEditing",
      "icon": "build/icon.png",
      "executableName": "recut",
      "synopsis": "Video editor for fan edits of movies and television",
      "publish": null
    },
    "appImage": {
      "artifactName": "ReCut-${version}-linux-x86_64.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "artifactName": "ReCut-${version}-macos-${arch}.${ext}",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extraResources": [
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "LICENSE.electron.txt"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        }
      ],
      "publish": null
    },
    "dmg": {
      "artifactName": "ReCut-${version}-macos-${arch}.${ext}",
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ReCut",
      "runAfterFinish": true,
      "artifactName": "ReCut-Setup-${version}.${ext}",
      "guid": "71b5ac76-3d71-54f8-ab45-e7992d0fc22e"
    },
    "portable": {
      "artifactName": "ReCut-Portable-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "recut",
        "name": "ReCut Project",
        "description": "ReCut fan-edit project",
        "role": "Editor",
        "mimeType": "application/x-recut"
      }
    ]
  }
}
