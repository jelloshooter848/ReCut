{
  "name": "recut",
  "productName": "ReCut",
  "version": "0.1.0",
  "description": "A Premiere-style desktop video editor purpose-built for fan edits of movies and television",
  "main": "dist/electron/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test -c tests/e2e/playwright.config.ts",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "app.recut.editor",
    "productName": "ReCut",
    "files": ["dist/**/*", "package.json"],
    "directories": { "output": "release" },
    "linux": { "target": ["AppImage"], "category": "AudioVideo" },
    "mac": { "target": ["dmg"] },
    "win": { "target": ["nsis"] }
  }
}
