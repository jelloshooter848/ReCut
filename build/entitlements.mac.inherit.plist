<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for every other piece of code inside ReCut.app (package.json -> build.mac.entitlementsInherit):
  the Electron helper apps (renderer, GPU, plugin), Electron Framework and its libraries, and the bundled
  Contents/Resources/ffmpeg/ffmpeg and ffprobe. electron-builder signs each of them separately with the hardened
  runtime and a secure timestamp, using this file.

  com.apple.security.cs.allow-jit
    Required by the renderer helper (V8 runs the UI's JavaScript and WebAssembly there). Harmless for the other
    helpers and for ffmpeg / ffprobe, which do not generate code. See entitlements.mac.plist for what is left out.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
